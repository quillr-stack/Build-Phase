# API Keys
ANTHROPIC_API_KEY=

# PostgreSQL (Use 'postgres' as host when running in Docker)
DATABASE_URL=postgresql+asyncpg://sattva:sattva_secret@postgres:5432/sattva_db

# Redis (Use 'redis' as host when running in Docker)
REDIS_URL=redis://redis:6379

# KuzuDB (Use /data path for Docker persistence)
KUZU_DB_PATH=/data/kuzu_graph

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_AGENTS_PER_RUN=10000
DEFAULT_AGENTS_PER_RUN=1000
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS_PER_AGENT=300

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
